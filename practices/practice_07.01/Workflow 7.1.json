    {
      "parameters": {
        "jsCode": "const diffText = $input.first().json.data; // или .body, зависит от HTTP-ноды\nconst lines = diffText.split('\\n');\nconst addedLines = [];\nlet currentPath = null;\nlet newLineNum = 0;\n\nfor (const line of lines) {\n  if (line.startsWith('+++ b/')) {\n    currentPath = line.slice(6); // убираем \"+++ b/\"\n  } else if (line.startsWith('@@')) {\n    // Формат: @@ -old,count +new,count @@\n    const match = line.match(/\\+(\\d+)(?:,\\d+)?/);\n    if (match) newLineNum = parseInt(match[1], 10);\n  } else if (currentPath && line.startsWith('+') && !line.startsWith('+++')) {\n    // Это добавленная строка\n    addedLines.push({\n      json: {\n        path: currentPath,\n        line: newLineNum,\n        content: line.slice(1) // сам код без +\n      }\n    });\n    newLineNum++;\n  } else if (currentPath && (line.startsWith(' ') || line.startsWith('-'))) {\n    // Контекст или удаление — номер в новой версии сдвигается только для контекста\n    if (line.startsWith(' ')) newLineNum++;\n  }\n}\n\nreturn [{\n  json: {\n    addedLines: addedLines // Возвращаем ОДИН айтем, внутри которого массив всех строк\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        16,
        -80
      ],
      "id": "aadd8658-3c3e-4c2e-b630-f88d6fe9d2b3",
      "name": "GetLines"
    },
    {
      "parameters": {
        "jsCode": "// Берем ответ от агента\nconst rawOutput = $input.first().json.output;\n\n// Очищаем от возможных markdown-тегов (```json ... ```)\nconst cleaned = rawOutput.replace(/```json|```/g, '').trim();\n\nlet commentsArray = [];\n\ntry {\n  commentsArray = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error(\"Модель вернула невалидный JSON: \" + rawOutput);\n}\n\n// Обрабатываем каждый комментарий: добавляем пометку AI и side: \"RIGHT\"\nconst updatedComments = commentsArray.map(c => {\n  return {\n    path: c.path,\n    line: c.line,\n    side: \"RIGHT\", // Обязательно для привязки к новой версии файла\n    body: `🤖 **Сгенерировано AI:**\\n\\n${c.body}` // Добавляем пометку\n  };\n});\n\n// Возвращаем один объект, где comments — это массив\nreturn [{\n  json: {\n    comments: updatedComments\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
