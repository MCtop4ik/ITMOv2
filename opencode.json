{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-ignore"
  ],
  "provider": {
    "vsellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VseLLM",
      "options": {
        "baseURL": "https://litellm.data-light.ru",
        "apiKey": "{env:VSELLM_API_KEY}"
      },
      "models": {
        "openai/gpt-5": {
          "name": "openai/gpt-5",
          "options": {
            "reasoningEffort": "high"
          },
          "cost": {
            "input": 0.00000125,
            "output": 0.00001000,
            "reasoning": 0.00001000,
            "cache_read": 0.000000125,
            "cache_write": 0.00000125,
            "search_query": 0.018
          }
        },
        "anthropic/claude-opus-5": {
          "name": "anthropic/claude-opus-5"
        }
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "simple-adder": {
      "type": "local",
      "command": [
        "/home/senya/Desktop/Projects/ITMOv2/practices/practice_04/mcp/.venv/bin/python",
        "/home/senya/Desktop/Projects/ITMOv2/practices/practice_04/mcp/main.py"
      ],
      "enabled": true
    }
  },
  "permission": {
    "bash": "ask",
    "webfetch": "allow"
  }
}

